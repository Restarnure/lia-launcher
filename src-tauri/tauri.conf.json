{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ЛІЯ",
  "mainBinaryName": "lia-launcher",
  "version": "1.1.0",
  "identifier": "ua.lia.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ЛІЯ",
        "width": 1200,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#0A0E16",
        "dragDropEnabled": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data: blob:; media-src 'self' https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "ЛІЯ",
    "shortDescription": "Лаунчер Minecraft",
    "longDescription": "ЛІЯ — швидкий український лаунчер Minecraft: збірки, моди з Modrinth, Fabric/Quilt/Forge/NeoForge, автоматична Java.",
    "category": "Game",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Ukrainian",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxNEM2NDYzQjk5MzNFRUUKUldUdVBwTzVZMlJNWVVlVHREOTVFeG1ESzhaSStJU1kvZWNwUHo2UUxybnRKUHlhVEhSR3NBazEK",
      "endpoints": [
        "https://github.com/Restarnure/lia-launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
